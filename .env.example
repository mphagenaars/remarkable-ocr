# ===========================================
# Remarkable OCR App - Environment Configuration
# ===========================================

# Configuratie modus: 'env', 'gui', of 'hybrid'
CONFIG_MODE=gui

# ===========================================
# Server Configuratie (PRIORITEIT 1)
# ===========================================

# Server host (0.0.0.0 voor toegang vanaf buiten LXC)
HOST=0.0.0.0

# Server poort
PORT=8000

# Debug modus
DEBUG=false

# ===========================================
# Email Account Configuratie (PRIORITEIT 1)
# ===========================================

# Hoofd email account (ontvangt reMarkable PDFs)
EMAIL=

# Email wachtwoord/app-password
EMAIL_PASSWORD=

# IMAP server voor email ontvangst
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# SMTP server voor email verzending
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ===========================================
# Sender Whitelist (PRIORITEIT 1)  
# ===========================================

# Toegestane afzenders (komma gescheiden)
# Dit zijn de email adressen die PDFs mogen sturen
ALLOWED_SENDERS=my@remarkable.com

# ===========================================
# Notificatie Configuratie (PRIORITEIT 2)
# ===========================================

# Email adres waar OCR resultaten naartoe gaan
# Laat leeg om hoofdemail te gebruiken
NOTIFICATION_EMAIL=

# ===========================================
# OCR Configuratie (PRIORITEIT 2)
# ===========================================

# OpenRouter API key voor OCR functionaliteit
OPENROUTER_API_KEY=

# OCR model (default: google/gemini-2.5-flash)
OCR_MODEL=google/gemini-2.5-flash

# ===========================================
# Polling Configuratie (PRIORITEIT 3)
# ===========================================

# Automatisch starten van polling bij app start
AUTO_START_POLLING=false

# Polling interval in seconden (default: 300 = 5 minuten)
POLLING_INTERVAL=300

# Maximum aantal berichten per polling cyclus
MAX_MESSAGES_PER_POLL=10

# ===========================================
# Advanced Settings (OPTIONEEL)
# ===========================================

# Maximale bestandsgrootte in MB
MAX_FILE_SIZE=50

# Ondersteunde bestandstypen (komma gescheiden)
SUPPORTED_FORMATS=pdf,png

# Automatisch markeren als gelezen na verwerking
MARK_AS_READ=true

# Logging niveau (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Log naar bestand
LOG_TO_FILE=false

# ===========================================
# Email Provider Presets
# ===========================================

# Gmail:
# IMAP_SERVER=imap.gmail.com
# IMAP_PORT=993
# SMTP_SERVER=smtp.gmail.com  
# SMTP_PORT=587

# Outlook/Hotmail:
# IMAP_SERVER=outlook.office365.com
# IMAP_PORT=993
# SMTP_SERVER=smtp-mail.outlook.com
# SMTP_PORT=587

# Yahoo:
# IMAP_SERVER=imap.mail.yahoo.com
# IMAP_PORT=993
# SMTP_SERVER=smtp.mail.yahoo.com
# SMTP_PORT=587
